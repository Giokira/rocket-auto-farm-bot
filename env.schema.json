{
  "description": "Variabili .env effettivamente usate dal setup: PAYMENT_METHOD=giftcard, LICENSE_MODE=online. type: string|int|bool|enum|path|url|secret.",
  "variables": [
    { "key": "TELEGRAM_BOT_TOKEN", "type": "secret", "required": true, "default": null, "group": "Telegram", "description": "Token del bot, da @BotFather." },
    { "key": "ADMIN_USER_ID", "type": "int", "required": true, "default": null, "group": "Telegram", "description": "Tuo id Telegram numerico, da @userinfobot." },

    { "key": "PAYMENT_METHOD", "type": "enum", "values": ["giftcard"], "required": false, "default": "giftcard", "group": "Pagamento", "description": "Metodo di pagamento. Fisso a giftcard." },
    { "key": "GIFTCARD_ENABLED", "type": "bool", "required": false, "default": true, "group": "Pagamento", "description": "Abilita il pagamento con buono a codice." },
    { "key": "GIFTCARD_INSTRUCTIONS", "type": "string", "required": false, "default": "", "group": "Pagamento", "description": "Testo mostrato al compratore (istruzioni buono Amazon). Vuoto = testo di default." },

    { "key": "LICENSE_MODE", "type": "enum", "values": ["online"], "required": false, "default": "online", "group": "Licenza", "description": "Fisso a online: token validato dal server, nessuna chiave privata." },
    { "key": "TOKEN_PREFIX", "type": "string", "required": false, "default": "GKR1-", "group": "Licenza", "description": "Prefisso leggibile dei token. Nessun ruolo di sicurezza." },
    { "key": "LICENSE_HOST", "type": "string", "required": false, "default": "127.0.0.1", "group": "Server licenze", "description": "Interfaccia di ascolto del server licenze. Lascia 127.0.0.1, ci va davanti il reverse proxy." },
    { "key": "LICENSE_PORT", "type": "int", "required": false, "default": 8787, "group": "Server licenze", "description": "Porta locale del server licenze." },
    { "key": "PAYLOAD_PATH", "type": "path", "required": false, "default": "payload/rocket-auto-farm.bin", "group": "Server licenze", "description": "File del payload (classi della mod) servito dopo un token valido." },

    { "key": "DB_PATH", "type": "path", "required": false, "default": "orders.db", "group": "Sistema", "description": "File SQLite degli ordini." },
    { "key": "FILES_DIR", "type": "path", "required": false, "default": "files", "group": "Sistema", "description": "Cartella con i file consegnati (lo shell jar)." },
    { "key": "LOG_LEVEL", "type": "enum", "values": ["DEBUG", "INFO", "WARNING", "ERROR"], "required": false, "default": "INFO", "group": "Sistema", "description": "Livello di log." },
    { "key": "ORDER_RATE_LIMIT_MAX", "type": "int", "required": false, "default": 3, "group": "Sistema", "description": "Richieste di ordine consentite nella finestra." },
    { "key": "ORDER_RATE_LIMIT_SECONDS", "type": "int", "required": false, "default": 60, "group": "Sistema", "description": "Durata della finestra del rate limit, in secondi." }
  ]
}
