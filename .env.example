# ============ OBBLIGATORIE ============
# Token del bot, ottenuto da @BotFather
TELEGRAM_BOT_TOKEN=123456789:PLACEHOLDER_INSERISCI_QUI_IL_TUO_TOKEN

# Il TUO user_id Telegram (numerico). Per scoprirlo: scrivi a @userinfobot
ADMIN_USER_ID=000000000

# ============ PAGAMENTO ============
# giftcard (default): il compratore manda un CODICE (buono Amazon), tu lo
#          riscatti a mano su amazon.it e confermi. Nessun tuo nome mostrato.
PAYMENT_METHOD=giftcard
GIFTCARD_ENABLED=true
# Testo mostrato al compratore. Vuoto = testo di default per un buono Amazon.
GIFTCARD_INSTRUCTIONS=Compra un buono regalo Amazon (amazon.it) dell'importo esatto dell'ordine.

# ============ LICENZA (modello online) ============
# online: la mod chiede il payload al server licenze a ogni avvio, passando
# token+username. Nessuna chiave privata da custodire.
LICENSE_MODE=online
TOKEN_PREFIX=GKR1-

# Server di validazione licenze (processo separato: license_server.py).
# Ascolta su localhost, il TLS lo mette il reverse proxy davanti (vedi DEPLOY.md).
LICENSE_HOST=127.0.0.1
LICENSE_PORT=8787
# File con le classi protette della mod, servito solo dopo un token valido.
PAYLOAD_PATH=payload/rocket-auto-farm.bin

# ============ OPZIONALI ============
DB_PATH=orders.db
FILES_DIR=files
ORDER_RATE_LIMIT_MAX=3
ORDER_RATE_LIMIT_SECONDS=60
LOG_LEVEL=INFO

# ============ AVANZATO: non usato in questo setup ============
# PayPal, disponibile ma spento (PAYMENT_METHOD=giftcard e' il default).
# Per attivarlo: PAYMENT_METHOD=paypal e compila PAYPAL_EMAIL o PAYPAL_ME_LINK.
# PAYPAL_EMAIL=
# PAYPAL_ME_LINK=
# PAYPAL_MODE=amici_famiglia
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# PAYPAL_API_BASE=https://api-m.paypal.com
# PAYPAL_MERCHANT_ID=
# PAYPAL_AUTOCONFIRM=false

# Modello di licenza offline (Ed25519 locale), alternativo a online. Non usare
# su un VPS: la chiave privata non deve mai stare su un server pubblico.
# KEYGEN_CMD=java tools/Keygen.java {username}
# KEYGEN_CWD=.
# PRIVATE_KEY_PATH=tools/giokiradd-private.key
# KEYGEN_TIMEOUT=60
